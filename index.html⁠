              <span class="text-lg font-bold font-mono text-amber-400 w-5 text-center">${idx + 1}</span>
              <div class="flex-1 min-w-0">
                <h3 class="text-sm font-bold text-white truncate">${art.title}</h3>
                <p class="text-[11px] text-slate-400 truncate">${art.localized_museum || art.museum} / ${art.artist}</p>
              </div>
              <span class="text-xs font-mono font-bold text-emerald-400">+${art.up_votes || 0}</span>
            </div>
          `;
        }).join('');
      } catch (err) {
        list.innerHTML = `<div class="p-4 text-center text-xs text-rose-400 bg-slate-900 border border-slate-800 rounded-xl">取得失敗</div>`;
      }
    }

    // マイログ（端末内履歴）
    async function renderMyLogs() {
      const list = document.getElementById('myLogList');
      const logs = await dbGetAll('my_logs');

      document.getElementById('myLogCountBadge').innerText = `${logs.length} 作品`;

      if (logs.length === 0) {
        list.innerHTML = `<div class="p-4 text-center text-xs text-slate-500 bg-slate-900 border border-slate-800 rounded-xl">No logs.</div>`;
        return;
      }

      list.innerHTML = logs.slice().reverse().map(log => {
        return `
          <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 flex justify-between items-center cursor-pointer hover:border-slate-700">
            <div class="min-w-0 pr-2">
              <span class="text-[10px] text-slate-500">${log.museum} [${(log.lang_code || 'ja').toUpperCase()}]</span>
              <h3 class="text-sm font-bold text-white truncate">${log.title || 'Artwork'}</h3>
              <p class="text-[11px] text-slate-400 truncate">${log.meta || ''}</p>
            </div>
          </div>
        `;
      }).join('');
    }

    // 魚拓・ランキングからの読み込み復元
    window.loadArtworkData = function(data) {
      currentArtworkId = data.id;

      if (window.speechSynthesis && window.speechSynthesis.speaking) {
        window.speechSynthesis.cancel();
      }
      playAudioBtnText.innerText = I18N[currentLangCode]?.playAudio || 'Listen';

      document.querySelectorAll('main > section').forEach(sec => sec.classList.add('hidden'));
      document.getElementById('tab-scan').classList.remove('hidden');
      document.querySelectorAll('.nav-tab').forEach(t => t.className = 'nav-tab flex flex-col items-center gap-0.5 text-slate-400 hover:text-slate-200');
      document.querySelector('.nav-tab[data-target="tab-scan"]').className = 'nav-tab flex flex-col items-center gap-0.5 text-amber-400 font-bold';

      displayArtworkData(data);

      resultCard.classList.remove('hidden');
      if (isHeadphoneConnected) {
        audioGuidePanel.classList.remove('hidden');
        headphoneWarning.classList.add('hidden');
      } else {
        audioGuidePanel.classList.add('hidden');
        headphoneWarning.classList.remove('hidden');
      }
      resultCard.scrollIntoView({ behavior: 'smooth' });
    };

    applyLocalization('ja');
  </script>
</body>
</html>
