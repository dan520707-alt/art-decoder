<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Art Decoder Platform v2.1-Global8</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col items-center pb-20 select-none">
  
  <!-- ヘッダー -->
  <header class="w-full max-w-md py-3 px-4 flex justify-between items-center border-b border-slate-800 bg-slate-950/80 sticky top-0 z-30 backdrop-blur">
    <div class="flex items-center gap-2">
      <h1 class="text-lg font-bold tracking-wider text-amber-400">ART DECODER</h1>
      <span class="text-[10px] bg-emerald-500/20 text-emerald-300 px-1.5 py-0.5 rounded font-mono">v2.1-Global8</span>
    </div>
    <div class="flex items-center gap-2">
      <select id="langSelect" class="bg-slate-900 border border-slate-700 text-amber-300 text-xs font-bold rounded-lg px-2 py-1 focus:outline-none">
        <option value="ja">JA</option>
        <option value="en">EN</option>
        <option value="fr">FR</option>
        <option value="it">IT</option>
        <option value="de">DE</option>
        <option value="es">ES</option>
        <option value="ru">RU</option>
        <option value="zh">ZH</option>
      </select>
      <button id="audioBadge" class="text-[10px] text-slate-400 border border-slate-800 bg-slate-900 px-2 py-1 rounded-full flex items-center gap-1.5 transition-colors cursor-pointer active:scale-95">
        <span class="w-1.5 h-1.5 rounded-full bg-slate-600" id="badgeDot"></span>
        <span id="badgeText">イヤホン未検出</span>
      </button>
    </div>
  </header>

  <!-- メインコンテンツ -->
  <main class="w-full max-w-md flex-1 p-4 flex flex-col gap-3">
    
    <!-- TAB 1: スキャン -->
    <section id="tab-scan" class="flex flex-col gap-3">
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 flex flex-col gap-2">
        <span class="text-xs font-bold text-amber-400 flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
          <span id="locSettingLabel">鑑賞ロケーション設定</span>
        </span>
        <div class="flex flex-col gap-2">
          <input type="text" id="museumInput" placeholder="美術館名" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-amber-500 select-text">
          <div class="grid grid-cols-2 gap-2">
            <select id="exhibitTypeSelect" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-amber-500">
              <option value="常設展" id="optPermanent">常設展</option>
              <option value="企画展" id="optSpecial">企画展</option>
            </select>
            <input type="text" id="specialExNameInput" placeholder="企画展名" class="hidden w-full bg-slate-950 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-amber-500 select-text">
          </div>
        </div>
      </div>

      <!-- 写真入力 -->
      <div class="relative w-full aspect-[4/3] bg-slate-900 border-2 border-dashed border-slate-700 rounded-xl overflow-hidden flex flex-col items-center justify-center">
        <img id="preview" class="absolute inset-0 w-full h-full object-cover hidden" alt="Preview">
        
        <div id="placeholder" class="flex flex-col items-center gap-2 pointer-events-none p-4 text-center z-10">
          <svg class="w-10 h-10 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span id="placeholderText" class="text-sm text-slate-400">写真を撮影または選択</span>
          <span id="guideTipText" class="text-[10px] text-amber-400/90 bg-slate-950/80 px-2 py-0.5 rounded border border-amber-500/30">💡 作品名や銘のキャプションを端に入れると精度MAX</span>
        </div>
        <input type="file" id="cameraInput" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer z-20">
      </div>

      <!-- モード切替 -->
      <div class="grid grid-cols-2 p-1 bg-slate-900 border border-slate-800 rounded-xl text-xs font-bold gap-1">
        <button id="modeQuickBtn" class="py-2.5 rounded-lg bg-amber-500 text-slate-950 transition-all flex items-center justify-center gap-1 font-bold">
          <span id="modeQuickText">⚡️ 要約・速聴</span>
          <span id="modeQuickSub" class="text-[10px] opacity-80 font-mono">（約5秒）</span>
        </button>
        <button id="modeDeepBtn" class="py-2.5 rounded-lg text-slate-400 hover:text-slate-200 transition-all flex items-center justify-center gap-1 font-bold">
          <span id="modeDeepText">🔍 詳細解読</span>
          <span id="modeDeepSub" class="text-[10px] opacity-80 font-mono">（約12秒）</span>
        </button>
      </div>

      <button id="decodeBtn" class="w-full py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-xl shadow-lg transition-all disabled:opacity-50">
        要約をデコードする
      </button>

      <!-- 結果カード -->
      <div id="resultCard" class="hidden flex flex-col gap-3 bg-slate-900 border border-slate-800 rounded-xl p-4">
        <div class="border-b border-slate-800 pb-2 flex justify-between items-start">
          <div>
            <div class="flex items-center gap-1.5 flex-wrap">
              <span id="cardMuseumTag" class="text-[10px] bg-slate-800 text-amber-300 px-1.5 py-0.5 rounded font-mono"></span>
              <span id="cardExhibitTag" class="text-[10px] bg-slate-800 text-slate-300 px-1.5 py-0.5 rounded"></span>
              <span id="cardLangTag" class="text-[10px] bg-amber-500/20 text-amber-300 px-1 py-0.5 rounded font-mono uppercase"></span>
            </div>
            <h2 id="artTitle" class="text-lg font-bold text-white mt-1 select-text"></h2>
            <p id="artMeta" class="text-xs text-slate-400 select-text"></p>
          </div>
          <div class="flex items-center gap-1 bg-slate-950 p-1 rounded-lg border border-slate-800">
            <button id="thumbUpBtn" class="p-1.5 rounded hover:bg-slate-800 text-slate-400 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"></path></svg>
            </button>
            <button id="thumbDownBtn" class="p-1.5 rounded hover:bg-slate-800 text-slate-400 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018a2 2 0 01.485.06l3.76 1.04m-7 10v5a2 2 0 002 2h.096c.5 0 .905-.405.905-.905 0-.714.211-1.412.608-2.006L17 13V4m-7 10h2m5-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2.5"></path></svg>
            </button>
          </div>
        </div>

        <!-- 音声操作バー -->
        <div id="audioGuidePanel" class="hidden bg-amber-500/10 border border-amber-500/30 rounded-xl p-3 flex flex-col gap-2">
          <div class="flex gap-2">
            <button id="playAudioBtn" class="flex-1 py-2.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs rounded-lg flex items-center justify-center gap-1.5 shadow active:scale-95 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path></svg>
              <span id="playAudioBtnText">解説を聴く</span>
            </button>
            <button id="selectTextBtn" class="px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold rounded-lg border border-slate-700 active:scale-95 transition-transform flex items-center gap-1">
              <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
              <span id="selectTextBtnText">全選択</span>
            </button>
          </div>
        </div>

        <div id="headphoneWarning" class="p-3 rounded-xl bg-slate-950/60 border border-dashed border-slate-800 flex items-center justify-between text-xs text-slate-400">
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            <span id="headphoneWarningText">イヤホン接続時のみ音声利用可</span>
          </span>
          <span class="text-[10px] text-slate-500" id="badgeNoticeText">（右上のバッジで切替可能）</span>
        </div>

        <div id="textContainer" class="space-y-3.5 text-sm p-1 select-text leading-relaxed">
          <div id="summaryBlock" class="hidden">
            <span class="text-xs font-semibold text-amber-400 uppercase tracking-wider" id="lblSummaryHead">要約オーディオガイド</span>
            <p id="summaryPoint" class="text-slate-200 mt-1 whitespace-pre-wrap select-text"></p>
          </div>

          <div id="detailBlock" class="space-y-3.5">
            <div>
              <span class="text-xs font-semibold text-amber-400 uppercase tracking-wider" id="lblFocusHead">01 / 物理的着眼点</span>
              <p id="focusPoint" class="text-slate-200 mt-1 whitespace-pre-wrap select-text"></p>
            </div>
            <div>
              <span class="text-xs font-semibold text-amber-400 uppercase tracking-wider" id="lblContextHead">02 / 画家の文脈・制約</span>
              <p id="contextPoint" class="text-slate-200 mt-1 whitespace-pre-wrap select-text"></p>
            </div>
            <div>
              <span class="text-xs font-semibold text-amber-400 uppercase tracking-wider" id="lblContrastHead">03 / 構造的対比</span>
              <p id="contrastPoint" class="text-slate-200 mt-1 whitespace-pre-wrap select-text"></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TAB 2: 館内作品（Cloudflare D1） -->
    <section id="tab-museum" class="hidden flex flex-col gap-3">
      <div class="flex justify-between items-center">
        <h2 class="text-sm font-bold text-white" id="museumTabTitle">魚拓ライブラリ（Cloudflare D1）</h2>
        <div class="flex items-center gap-1.5">
          <span id="museumLangFilterBadge" class="text-[10px] bg-amber-500/20 text-amber-300 px-2 py-0.5 rounded font-mono">LANG: JA</span>
          <span id="museumFilterBadge" class="text-[10px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded">全館</span>
        </div>
      </div>
      <div id="museumArtworkList" class="flex flex-col gap-2"></div>
    </section>

    <!-- TAB 3: ランキング（Cloudflare D1） -->
    <section id="tab-rank" class="hidden flex flex-col gap-3">
      <div class="flex justify-between items-center">
        <h2 class="text-sm font-bold text-white" id="rankTabTitle">人気作品ランキング</h2>
        <span class="text-[10px] text-slate-400" id="rankTabSub">リアルタイム集計</span>
      </div>
      <div id="rankingList" class="flex flex-col gap-2"></div>
    </section>

    <!-- TAB 4: マイログ -->
    <section id="tab-log" class="hidden flex flex-col gap-3">
      <div class="flex justify-between items-center">
        <h2 class="text-sm font-bold text-white" id="logTabTitle">鑑賞ログ履歴</h2>
        <span id="myLogCountBadge" class="text-[10px] text-amber-400 font-mono">0 作品</span>
      </div>
      <div id="myLogList" class="flex flex-col gap-2"></div>
    </section>
  </main>

  <!-- ボトムナビ -->
  <nav class="fixed bottom-0 left-0 right-0 max-w-md mx-auto bg-slate-950/95 border-t border-slate-800 flex justify-around py-2 z-40 backdrop-blur">
