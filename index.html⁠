      const uttr = new SpeechSynthesisUtterance(textToRead);
      const langVoiceMap = {
        ja: 'ja-JP', en: 'en-US', fr: 'fr-FR', it: 'it-IT',
        de: 'de-DE', es: 'es-ES', ru: 'ru-RU', zh: 'zh-CN'
