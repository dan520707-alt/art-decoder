<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Art Decoder</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col items-center p-4">
  
  <header class="w-full max-w-md py-4 flex justify-between items-center border-b border-slate-800 mb-4">
    <h1 class="text-xl font-bold tracking-wider text-amber-400">ART DECODER</h1>
    <span class="text-xs text-slate-400 border border-slate-700 px-2 py-1 rounded">BETA</span>
  </header>

  <main class="w-full max-w-md flex-1 flex flex-col gap-4">
    <!-- カメラ入力枠 -->
    <div class="relative w-full aspect-[4/3] bg-slate-900 border-2 border-dashed border-slate-700 rounded-xl overflow-hidden flex flex-col items-center justify-center">
      <img id="preview" class="absolute inset-0 w-full h-full object-cover hidden" alt="Preview">
      <div id="placeholder" class="flex flex-col items-center gap-2 pointer-events-none">
        <svg class="w-10 h-10 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span class="text-sm text-slate-400">作品を撮影または選択</span>
      </div>
      <input type="file" id="cameraInput" accept="image/*" capture="environment" class="absolute inset-0 opacity-0 cursor-pointer">
    </div>

    <!-- アクションボタン -->
    <button id="decodeBtn" class="w-full py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-xl shadow-lg transition-all disabled:opacity-50 disabled:cursor-not-allowed">
      作品をデコードする
    </button>

    <!-- デコード結果カード（初期状態は非表示） -->
    <div id="resultCard" class="hidden flex flex-col gap-3 bg-slate-900 border border-slate-800 rounded-xl p-4 mt-2">
      <div class="border-b border-slate-800 pb-2">
        <h2 id="artTitle" class="text-lg font-bold text-white">作品タイトル未定</h2>
        <p id="artMeta" class="text-xs text-slate-400">年代・作家名</p>
      </div>

      <div class="space-y-3 text-sm">
        <div>
          <span class="text-xs font-semibold text-amber-400 uppercase tracking-wider">01 / 物理的着眼点（筆致・視線誘導）</span>
          <p id="focusPoint" class="text-slate-300 mt-1 leading-relaxed"></p>
        </div>
        <div>
          <span class="text-xs font-semibold text-amber-400 uppercase tracking-wider">02 / 画家の文脈・制約</span>
          <p id="contextPoint" class="text-slate-300 mt-1 leading-relaxed"></p>
        </div>
        <div>
          <span class="text-xs font-semibold text-amber-400 uppercase tracking-wider">03 / 構造的対比</span>
          <p id="contrastPoint" class="text-slate-300 mt-1 leading-relaxed"></p>
        </div>
      </div>
    </div>
  </main>

  <script>
    const cameraInput = document.getElementById('cameraInput');
    const preview = document.getElementById('preview');
    const placeholder = document.getElementById('placeholder');
    const decodeBtn = document.getElementById('decodeBtn');
    const resultCard = document.getElementById('resultCard');

    let startTime = Date.now();

    cameraInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (event) => {
          preview.src = event.target.result;
          preview.classList.remove('hidden');
          placeholder.classList.add('hidden');
        };
        reader.readAsDataURL(file);
      }
    });

    decodeBtn.addEventListener('click', () => {
      decodeBtn.innerText = 'デコード中...';
      decodeBtn.disabled = true;

      const telemetry = {
        dwellTimeMs: Date.now() - startTime,
        connection: navigator.connection ? navigator.connection.effectiveType : 'unknown',
        userAgent: navigator.userAgent
      };
      console.log('Telemetry Log:', telemetry);

      setTimeout(() => {
        document.getElementById('artTitle').innerText = '睡蓮の池（サンプルデコード）';
        document.getElementById('artMeta').innerText = 'クロード・モネ / 1899年';
        document.getElementById('focusPoint').innerText = '右上の筆致に注目。原色をパレットで混ぜずキャンバス上で直接重ねる視覚混合を採用。3m以上離れると光の反射として脳内結像する構造。';
        document.getElementById('contextPoint').innerText = '白内障の進行初期。青・黄のコントラストを極端に強調し始めた過渡期の作品。視界の混濁を作風の解体へと昇華させている。';
        document.getElementById('contrastPoint').innerText = 'ルノワールが人物の肌の血色に固執したのに対し、モネは固体の輪郭を完全に放棄し、水面に映る虚像のみを主役として固定化。';

        resultCard.classList.remove('hidden');
        decodeBtn.innerText = '別の作品をデコードする';
        decodeBtn.disabled = false;
        resultCard.scrollIntoView({ behavior: 'smooth' });
      }, 1000);
    });
  </script>
</body>
</html>

